# Copie este arquivo para .env (o .env não vai para o GitHub) e preencha com os seus dados.

# Supabase: Project Settings > Database > Connection string > "Session pooler" (URI).
# Troque [YOUR-PASSWORD] pela senha do banco definida ao criar o projeto.
# Sem DATABASE_URL, o iniciar.bat usa o PostgreSQL portátil local.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Redis: local (Docker: docker compose up -d redis) ou na nuvem (Upstash/Redis Cloud, use rediss://).
# Sem REDIS_URL, a aplicação funciona sem cache.
REDIS_URL=redis://127.0.0.1:6379/0
# Tempo, em segundos, que cada leitura fica guardada no Redis.
CACHE_TTL=60

APP_HOST=127.0.0.1
APP_PORT=5000
